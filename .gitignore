# Whitelist mode: ignore everything except the themes directory.

# Ignore everything at the repo root...
/*

# ...but keep this gitignore and the wp-content path open
!/.gitignore
!/wp-content

# Inside wp-content, ignore everything except the themes directory
/wp-content/*
!/wp-content/themes

# WordPress default / example themes
/wp-content/themes/twenty*/

# Dependencies (never track, even inside the theme)
node_modules/
